{
  "extends": "./base.json",
  "compilerOptions": {
    "types": ["vitest/globals", "vitest/importMeta", "vite/client", "node"]
  },
  "include": [
    "${configDir}/vite.config.ts",
    "${configDir}/vitest.config.ts",
    "${configDir}/src/**/*.test.*",
    "${configDir}/src/**/*.spec.*",
    "${configDir}/src/**/*.d.ts",
    "${configDir}/modules/*/vite.config.ts",
    "${configDir}/modules/*/vitest.config.ts",
    "${configDir}/modules/*/src/**/*.test.*",
    "${configDir}/modules/*/src/**/*.spec.*",
    "${configDir}/modules/*/src/**/*.d.ts"
  ]
}
