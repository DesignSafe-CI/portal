    "jsdom": "~22.1.0",
    "msw": "^2.0.11",
    "prettier": "^2.6.2",
    "typescript": "~6.0.3",
    "vite": "^8.3.0",
    "vitest": "^5.0.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24.22.2",
      "onFail": "download"
    }
  }
}
