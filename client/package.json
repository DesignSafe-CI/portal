{
  "name": "@client/source",
  "version": "0.0.0",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@12.3.4",
  "scripts": {
    "start": "vite",
    "dev": "vite",
    "build": "pnpm typecheck && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:workspaces": "pnpm --recursive --if-present test",
    "typecheck": "tsc --build",
    "format:check": "prettier --check .",
    "format:write": "prettier . --write",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "e2e": "playwright test --config=e2e/playwright.config.ts"
  },
  "private": true,
  "dependencies": {
    "@ant-design/icons": "^5.6.1",
    "@ant-design/v5-patch-for-react-19": "^1.0.3",
    "@ant-design/x": "^1.6.0",
    "@client/common-components": "workspace:*",
    "@client/dashboard": "workspace:*",
    "@client/datafiles": "workspace:*",
    "@client/hooks": "workspace:*",
    "@client/nco": "workspace:*",
    "@client/onboarding": "workspace:*",
    "@client/reconportal": "workspace:*",
    "@client/test-fixtures": "workspace:*",
    "@client/workspace": "workspace:*",
    "@fortawesome/free-solid-svg-icons": "^6.7.2",
    "@fortawesome/react-fontawesome": "^0.2.2",
    "@hookform/resolvers": "^3.3.4",
    "@tanstack/react-query": "^5.15.0",
    "@turf/helpers": "^7.0.0",
    "@turf/turf": "^7.0.0",
    "antd": "^5.16.4",
    "axios": "^1.6.3",
    "dayjs": "^1.11.0",
    "html-react-parser": "^5.1.10",
    "leaflet": "^1.9.4",
    "leaflet.markercluster": "^1.5.3",
    "markdown-it": "^14.1.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-error-boundary": "^4.0.13",
    "react-google-recaptcha": "^3.1.0",
    "react-hook-form": "^7.51.3",
    "react-hook-form-antd": "^1.1.0",
    "react-leaflet": "^5.0.0",
    "react-leaflet-custom-control": "~1.5.0",
    "react-leaflet-markercluster": "^5.0.0-rc.0",
    "react-router-dom": "^7.18.5",
    "react-use-websocket": "^4.8.1",
    "tslib": "^2.3.0",
    "zod": "^3.23.4"
